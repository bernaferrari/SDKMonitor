{
  "$schema": "https://unpkg.com/screenshot-studio/studio/schemas/studio.schema.json",
  "app": "SDK Monitor",
  "package": "com.bernaferrari.sdkmonitor",
  "locales": [
    "en-US",
    "de-DE",
    "es-ES",
    "fr-FR",
    "it-IT",
    "pt-BR",
    "ja-JP",
    "zh-CN"
  ],
  "defaultLocale": "en-US",
  "supersample": 2,
  "capture": {
    "build": "./gradlew :app:assembleStoreCapture -q",
    "install": [
      {
        "apk": "app/build/outputs/apk/storeCapture/app-storeCapture.apk",
        "package": "com.bernaferrari.sdkmonitor.storecapture"
      }
    ],
    "runs": [
      {
        "locales": "default"
      }
    ]
  },
  "bounds": {
    "layouts": {
      "tablet10": {
        "right": 0.22
      },
      "hang": {
        "top": true
      }
    }
  },
  "frames": {
    "fixed": [
      "banner"
    ]
  }
}
